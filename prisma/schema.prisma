generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String      @id @default(cuid())
  name             String?
  email            String      @unique
  password         String
  sessionVersion   Int         @default(0)
  passwordChangedAt DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  image            String?
  signature        String?
  workScheduleJson Json?
  calculationSource String     @default("local_estimate")
  hourlyRate       Float?
  federalStatus    String?     @default("S")
  stateStatus      String?     @default("S-00")
  federalTaxPercent Float      @default(0)
  stateTaxPercent  Float       @default(0)
  otherDeductionMonthly Float  @default(0)
  monthlySummaryEmailEnabled Boolean @default(true)
  entries          TimeEntry[]
  otpChallenges    LoginOtpChallenge[]
  passwordResets   PasswordResetToken[]
  authAuditLogs    AuthAuditLog[]
  monthlySummaryEmails MonthlySummaryEmailLog[]
  payrollPeriods       PayrollPeriod[]
  positions            Position[]
}

/// A job the user holds (e.g. an SA and an ISA position). Each has its own
/// timesheet template, pay rate, and regular schedule.
model Position {
  id               String      @id @default(cuid())
  userId           String
  name             String
  /// Timesheet template role: "student_assistant" | "instructional_student_assistant".
  role             String      @default("student_assistant")
  hourlyRate       Float       @default(0)
  workScheduleJson Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries          TimeEntry[]

  @@index([userId])
}

model PayrollPeriod {
  id        String   @id @default(cuid())
  userId    String
  label     String
  startDate String
  endDate   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, startDate, endDate])
  @@index([userId, startDate, endDate])
}

model TimeEntry {
  id        String   @id @default(cuid())
  userId    String
  positionId String
  /// Local calendar date in the user's timezone. Format: YYYY-MM-DD.
  date      String
  /// Local times in 24h clock. Format: HH:mm.
  punchIn   String
  punchOut  String
  notes     String?
  /// Session-based (ISA) days: one note per work session, in session time order.
  sessionNotes Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  breaks    Break[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position  Position @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@unique([userId, positionId, date])
  @@index([userId, date])
  @@index([positionId, date])
}

model Break {
  id          String    @id @default(cuid())
  timeEntryId String
  start       String
  end         String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  entry       TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  @@index([timeEntryId])
}

model LoginOtpChallenge {
  id         String   @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, consumedAt])
}

model AuthAuditLog {
  id        String   @id @default(cuid())
  event     String
  success   Boolean
  reason    String?
  email     String?
  userId    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event, createdAt])
  @@index([email, createdAt])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, usedAt])
}

model MonthlySummaryEmailLog {
  id        String   @id @default(cuid())
  userId    String
  month     String
  sentAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([month, sentAt])
}
