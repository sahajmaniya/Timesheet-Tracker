# PostgreSQL connection string (Neon/Supabase/Vercel Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXTAUTH_DEBUG="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OTP verification
OTP_SECRET="replace-with-another-long-random-string"

# SMTP (required in production for OTP email delivery)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASS="smtp-password"
SMTP_FROM="PunchPilot <no-reply@example.com>"
SUPPORT_INBOX="support@yourdomain.com"
CRON_SECRET="replace-with-a-long-random-cron-secret"

# Optional: password reset links use NEXT_PUBLIC_SITE_URL or NEXTAUTH_URL
# Optional: monthly summary cron endpoint expects Authorization: Bearer ${CRON_SECRET}
# Optional: enable dev API timing logs
PERF_API_LOGS="false"
